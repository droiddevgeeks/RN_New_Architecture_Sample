# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Build React Native core from source: the prebuilt React.framework ships with both interop
# layers compiled in, so the RCT_REMOVE_LEGACY_*_INTEROP flags in post_install would not
# reach it. Slower first build, but the interop code is actually gone from the app.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'RNNewArchSample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # New Architecture only: compile both interop layers out of React Native, so a
    # non-TurboModule module or non-Fabric view fails at build/run time instead of
    # silently falling back.
    ReactNativePodsUtils.add_compiler_flag_to_project(installer, "-DRCT_REMOVE_LEGACY_MODULE_INTEROP=1")
    ReactNativePodsUtils.add_compiler_flag_to_project(installer, "-DRCT_REMOVE_LEGACY_COMPONENT_INTEROP=1")
  end
end
